# --- Database (MAMP defaults: user root / pass root / MySQL port 8889) ---
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:8889/brand_alnashme?charset=utf8mb4
# If the TCP connection fails on MAMP, use the socket instead:
# DATABASE_URL=mysql+pymysql://root:root@localhost/brand_alnashme?charset=utf8mb4&unix_socket=/Applications/MAMP/tmp/mysql/mysql.sock

# --- App ---
SECRET_KEY=change-this-to-a-long-random-string
# Insert demo categories/products on the first run (set to false in production)
SEED_DEMO=true
# Default WhatsApp number (digits only, with country code). Editable later from Admin > Settings.
WHATSAPP_NUMBER=97337331306
